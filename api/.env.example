# Copy to .env for local (non-docker) runs. Docker compose sets these for you.
MONGODB_URI=mongodb://127.0.0.1:27017/cardboard
PORT=4000

# Set SEED=reset to wipe and reseed the database on startup.
SEED=

# Shared secret the inbound webhook checks (x-webhook-secret header).
WEBHOOK_SECRET=dev-secret

# Traffic simulator (the `simulator` service): fire the webhook every N ms, and
# optionally send a wrong secret this fraction of the time (0 = never).
SIMULATE_INTERVAL=10000
SIMULATE_BAD_SECRET_RATE=0
