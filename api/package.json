{
  "name": "cardboard-api",
  "version": "1.0.0",
  "private": true,
  "description": "Cardboard API — a small issue tracker backend (Express + Mongoose)",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
