{
  "name": "Cardboard",

  // No "image" and no "features" on purpose.
  //
  // This uses the default Codespaces image, which already carries Docker, the
  // GitHub CLI and an SSH server. The previous technical exercise ran on the
  // same default image with no features, so the arrangement is proven.
  //
  // Do not add the docker-in-docker feature to get Docker. The default image
  // has a yarn apt source whose signing key no longer verifies, the feature
  // runs `apt-get update` while it installs, and the install then fails with
  // "NO_PUBKEY 62D54FD4003F6525". Container creation fails, but the codespace
  // still reports Available on a fallback container, so the breakage is quiet.

  // Four containers plus Mongo. Two cores make the board timings in the data
  // station unreliable, which is the one measurement the exercise depends on.
  "hostRequirements": {
    "cpus": 4
  },

  "forwardPorts": [3000, 4000, 27017],
  "portsAttributes": {
    "3000": {
      "label": "Cardboard web",
      "onAutoForward": "notify"
    },
    "4000": {
      "label": "Cardboard API",
      "onAutoForward": "silent"
    },
    "27017": {
      "label": "MongoDB",
      "onAutoForward": "silent"
    }
  },

  // Build on create so the first start is quick. Start on every attach and
  // resume; `up -d` is safe to run again.
  "postCreateCommand": "docker compose build",
  "postStartCommand": "docker compose up -d"
}
