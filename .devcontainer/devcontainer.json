{
  "name": "Cardboard",

  // No "image" and no "features" on purpose.
  //
  // This uses the default Codespaces image, which already carries Docker, the
  // GitHub CLI and an SSH server. The previous technical exercise ran on the
  // same default image with no features, so the arrangement is proven.
  //
  // Do not add the docker-in-docker feature to get Docker. The default image
  // has a yarn apt source whose signing key no longer verifies, the feature
  // runs `apt-get update` while it installs, and the install then fails with
  // "NO_PUBKEY 62D54FD4003F6525". Container creation fails, but the codespace
  // still reports Available on a fallback container, so the breakage is quiet.

  // Four containers plus Mongo. Two cores make the board timings in the data
  // station unreliable, which is the one measurement the exercise depends on.
  "hostRequirements": {
    "cpus": 4
  },

  "forwardPorts": [3000, 4000, 27017],
  "portsAttributes": {
    "3000": {
      "label": "Cardboard web",
      "onAutoForward": "notify"
    },
    "4000": {
      "label": "Cardboard API",
      "onAutoForward": "silent"
    },
    "27017": {
      "label": "MongoDB",
      "onAutoForward": "silent"
    }
  },

  // Get every image with onCreateCommand, not postCreateCommand. A prebuild
  // runs onCreateCommand and updateContentCommand, but it skips
  // postCreateCommand. Only onCreateCommand puts the images into the prebuild.
  //
  // Both halves are necessary. `build` makes the api, web and simulator
  // images, but it does not pull mongo, because that service names an image
  // instead of a build context. Without the pull, mongo is fetched later, when
  // the containers start.
  "onCreateCommand": "docker compose pull --ignore-buildable && docker compose build",

  // Start on every start and resume; `up -d` is safe to run again.
  "postStartCommand": "docker compose up -d",

  // Show that the app is coming up. Without this the workspace looks empty
  // for about a minute while the containers start, which reads as a broken
  // environment. The command also leaves the API log on the screen, which is
  // the terminal the run-sheet asks the interviewer to keep open. `up -d`
  // repeats here on purpose, so the log tail cannot start before there is a
  // container to follow.
  "postAttachCommand": "docker compose up -d && docker compose logs -f api"
}
